{
  "$schema": "https://getcomposer.org/schema.json",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Demo API (Scalar Galaxy)"
    }
  ],
  "autoload": {
    "files": [
      "src/Version.php"
    ],
    "psr-4": {
      "DemoAPIScalarGalaxy\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    },
    "platform": {
      "php": "8.1"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "description": "The Scalar Galaxy is an example OpenAPI document to test OpenAPI tools and libraries. It's a fictional universe with fictional planets and fictional data. Get all the data for all planets.",
  "name": "scalar/demo-api-scalar-galaxy",
  "require": {
    "php": ">=8.1",
    "php-http/discovery": "^1",
    "psr/http-client": "^1",
    "psr/http-client-implementation": "^1",
    "psr/http-factory-implementation": "^1",
    "psr/http-message": "^1|^2",
    "standard-webhooks/standard-webhooks": "^1"
  }
}
